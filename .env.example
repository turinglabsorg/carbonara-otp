# Twilio credentials (copy from core/.env)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL (create via Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=

# Poll interval in seconds (default: 10)
POLL_INTERVAL=10
