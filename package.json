{
  "name": "@mtropro/virtual-otp",
  "version": "1.0.0",
  "description": "SMS-to-Telegram forwarder — polls Twilio for inbound SMS and forwards to Telegram",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.tsx",
    "dev": "tsx src/index.tsx",
    "as:guest": "tsx src/index.tsx --env .env.guest",
    "as:owner": "tsx src/index.tsx --env .env.owner"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.6",
    "twilio": "^4.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.16.1",
      "follow-redirects": "1.16.0"
    }
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
